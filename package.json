{
  "name": "edam-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "routes:generate": "tsr generate",
    "types:generate": "openapi-typescript http://localhost:8080/v3/api-docs -o src/api/generated/schema.d.ts",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run routes:generate && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "responsive:check": "node scripts/responsive-check.mjs",
    "contracts:permissions": "node scripts/generate-permission-codes.mjs",
    "predev": "npm run routes:generate",
    "pretest": "npm run routes:generate"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.160.0",
    "@tanstack/react-table": "8.20.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "decimal.js-light": "2.5.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@tanstack/router-cli": "1.160.0",
    "@tanstack/router-plugin": "1.160.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "jsdom": "25.0.1",
    "msw": "2.7.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.49",
    "puppeteer-core": "25.18.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
